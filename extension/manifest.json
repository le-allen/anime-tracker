{
  "manifest_version": 3,
  "name": "Anime Episode Tracker",
  "version": "1.1.0",
  "description": "Search AniList and keep track of the anime episodes you have watched.",
  "icons": {
    "16": "icons/icon.png",
    "32": "icons/icon.png",
    "48": "icons/icon.png",
    "96": "icons/icon.png"
  },
  "action": {
    "default_title": "Anime Episode Tracker",
    "default_popup": "popup/index.html",
    "default_icon": {
      "16": "icons/icon.png",
      "32": "icons/icon.png"
    }
  },
  "permissions": [
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "https://graphql.anilist.co/*"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "anime-episode-tracker@local",
      "strict_min_version": "128.0"
    }
  }
}
